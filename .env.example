# OpenObserve configuration
# URL of the running OpenObserve instance (do NOT include trailing slash).
OPENOBSERVE_URL=http://localhost:5080

# Organization (tenant) inside OpenObserve. The default is "default".
OPENOBSERVE_ORG=default

# Credentials. OpenObserve's default bootstrap user is
#   root@example.com / Complexpass#123
# Override these for any non-local setup.
OPENOBSERVE_USERNAME=root@example.com
OPENOBSERVE_PASSWORD=Complexpass#123

# How long HTTP requests to OpenObserve may take.
OPENOBSERVE_TIMEOUT=30s

# Optional: path for the MCP server to log to. Empty means stdout.
MCP_LOG_FILE=

# -----------------------------------------------------------------------------
# LLM agent configuration
# -----------------------------------------------------------------------------
# Anthropic Messages API key. Generate one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com
